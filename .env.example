# Copy is generated by `make env` (scripts/init_env.sh) with random values.
# Never commit .env. Every secret can also be passed as <NAME>_FILE.

AI_ENV=local
AI_LOG_LEVEL=info

# PostgreSQL: owner runs migrations, ai_app serves requests (row-level security applies to it)
AI_DB_OWNER_PASSWORD=__GENERATE__
AI_DB_APP_PASSWORD=__GENERATE__

# HS256 key shared with the token issuer (the CRM backend, once integrated). >= 32 bytes.
AI_AUTH_HS256_KEY=__GENERATE__
# AI_AUTH_HS256_KEY_PREVIOUS=   # set during key rotation only
# AI_AUTH_ISSUER=crm-platform
# AI_AUTH_AUDIENCE=crm-ai-platform
