{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge_answer.output.v1",
  "description": "An answer made only of statements that each quote a passage verbatim and cite it. There is no free-text answer. With nothing found, insufficient_data is true and statements is empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statements", "insufficient_data", "language", "generator"],
  "properties": {
    "schema": { "const": "knowledge_answer.output.v1" },
    "statements": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "passage_ref", "quote"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "passage_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}#[0-9]{1,6}$" },
          "quote": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    },
    "insufficient_data": { "type": "boolean" },
    "language": { "type": "string", "enum": ["ru", "ky", "en"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "is_mock"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "is_mock": { "type": "boolean" }
      }
    }
  }
}
