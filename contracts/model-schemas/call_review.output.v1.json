{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "call_review.output.v1",
  "description": "How the manager's call meets each criterion, in the input's order. met and partial quote the transcript word for word (case and spaces aside); there is no score: the CRM computes it from the statuses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "criteria", "strengths", "improvements", "insufficient_data", "language", "generator"],
  "properties": {
    "schema": { "const": "call_review.output.v1" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "evidence", "comment"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
          "status": { "type": "string", "enum": ["met", "partial", "missed", "not_applicable"] },
          "evidence": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["segment_id", "quote"],
                "properties": {
                  "segment_id": { "type": "string", "pattern": "^s[0-9]{1,4}$" },
                  "quote": { "type": "string", "minLength": 3, "maxLength": 300 }
                }
              }
            ]
          },
          "comment": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "strengths": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/advice" } },
    "improvements": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/advice" } },
    "insufficient_data": {
      "type": "boolean",
      "description": "True when the call is too short to review; then every status is not_applicable and the lists are empty."
    },
    "language": { "type": "string", "enum": ["ru", "ky", "en"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "is_mock"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "is_mock": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 300 } }
    }
  }
}
